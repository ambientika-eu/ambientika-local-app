# Ambientika Local App – Konfiguration
# Kopiere diese Datei nach .env und trage deine Zugangsdaten ein

# Ambientika Account (benötigt für MQTT Bridge)
AMBIENTIKA_EMAIL=deine@email.de
AMBIENTIKA_PASSWORD=deinPasswort

# MQTT Broker (Standard: integrierter Mosquitto Container)
MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_PREFIX=ambientika

# Abfrage-Intervall in Sekunden
POLL_INTERVAL=30

# Log-Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Zeitzone (Nachtzeit des Free-Cooling-Wächters, Zeitstempel)
TZ=Europe/Berlin

# Free-Cooling-Wächter: Mindestabstand/Hysterese statt Wetterstations-Vergleich.
# Einschalten hier oder in der App (Tab "Free Cooling"); Details README.
FREECOOLING_ENABLED=false
# Außenwert: bevorzugt ein Sensor am Haus auf MQTT ambientika/weather
# ({"temperature": 21.4, "humidity": 60}). OpenWeatherMap nur als Rückfallebene:
OWM_API_KEY=
OWM_LOCATION=
