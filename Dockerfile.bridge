# Local Ambientika bridge (cloud-free). Build context = repo root.
FROM python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir "paho-mqtt>=1.6,<3"
COPY ambientika_local_bridge.py /app/

# Raw-TCP port the ventilation units connect to.
EXPOSE 11000

# -u = unbuffered logs so `docker logs` is live.
CMD ["python", "-u", "ambientika_local_bridge.py"]
